// Treble twist by WLED Effects Studio - CC0 (https://creativecommons.org/publicdomain/zero/1.0/)
// a line across the middle, twisted into a spiral: the treble sets how hard, the mid which way it drifts
// Written for the studio's VJ, with an AI (Claude): made to move with the music - its motion winds on at the
// pace of the bass, mid or treble, and a hit pushes its zoom or its turn.
[preset00]
fRating=3
fGammaAdj=1.0
fDecay=0.93
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=6
bAdditiveWaves=0
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.85
fWaveScale=1.6
fWaveSmoothing=0.6
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=0.6
wave_g=0.6
wave_b=0.6
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=0
nMotionVectorsY=0
mv_dx=0
mv_dy=0
mv_l=0
mv_r=1
mv_g=1
mv_b=1
mv_a=0
per_frame_1=wave_r = 0.5 + 0.5*sin(time*1.31 + 1.3);
per_frame_2=wave_g = 0.5 + 0.5*sin(time*1.73 + 1.3 + 2.1);
per_frame_3=wave_b = 0.5 + 0.5*sin(time*2.09 + 1.3 + 4.2);
per_frame_4=ph = ph + 0.04*mid;
per_frame_5=q1 = ph;
per_frame_6=q2 = 0.03 + 0.07*treb_att;
per_frame_7=zoom = 1.012 + 0.02*max(bass_att - 1, 0);
per_pixel_1=rot = q2*sin(rad*7 - q1);
